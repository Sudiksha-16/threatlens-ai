# ========================================================
# ThreatLens AI - Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# ========================================================

# MongoDB Configuration
MONGODB_URL=mongodb://127.0.0.1:27017
DATABASE_NAME=threatlens_ai

# JWT Security
JWT_SECRET=your_super_secret_enterprise_soc_jwt_key_2026_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# VirusTotal Threat Intelligence API (Optional Secondary Backup)
# Leave blank to operate entirely on Local ML + Static PE Analysis + YARA
VIRUSTOTAL_API_KEY=

# Server Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
